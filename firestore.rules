rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isApprovedSeller() {
      return isSignedIn()
        && userDoc().data.role == 'seller'
        && userDoc().data.approved == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved']));
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && (
          isAdmin()
          || (isApprovedSeller() && resource.data.sellerId == request.auth.uid)
        ));
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin()
        || (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /property_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
